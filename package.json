{
  "name": "@wazoo/worlds-kit",
  "version": "0.1.0",
  "description": "A React component library for composing Worlds-backed interfaces with implicit persistence and master-detail selection.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.library.json",
    "format": "prettier \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --write",
    "format:check": "prettier \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --check",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.library.json",
    "test": "tsx --test tests/*.test.ts",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm test && pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.20.0",
    "prettier": "^3.9.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.24.0"
  }
}
